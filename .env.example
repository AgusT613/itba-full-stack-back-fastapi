# Environment Mode (development | production | test)
ENVIRONMENT="development"

# Database Connection (Optional - defaults to SQLite database_<env>.db if unset)
# For SQLite: sqlite:///src/database_dev.db
# For PostgreSQL: postgresql+psycopg://username:password@localhost:5432/itbank_db
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/itbank"

# JWT Authentication
AUTH_SECRET_KEY="your-jwt-secret-key-32-chars-minimum"
ALGORITHM="HS256"

# Frontend CORS Origin
ITBANK_HOMEBANKING_FRONTEND_URL="http://localhost:3000"

