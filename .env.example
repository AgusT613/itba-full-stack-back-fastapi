# ==============================================================================
# ITBANK Backend Environment Variables Template
# Copy this file to '.env' and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Runtime Mode
# ------------------------------------------------------------------------------
# Options: 'development' | 'production' | 'test'
# - 'development': auto-creates src/database_dev.db and auto-seeds admin, user, and empty accounts on startup.
# - 'production': uses src/database_prod.db (or PostgreSQL via DATABASE_URL), skips mock seeding, preserves data on shutdown.
# - 'test': used by pytest for isolated in-memory test executions.
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Database connection string.
# Examples:
# - SQLite: sqlite:///src/database_dev.db
# - PostgreSQL: postgresql+psycopg://user:password@localhost:5432/itbank
DATABASE_URL="your-sql-database-url-sqlite-postgresql-or-any"

# Optional: Set to 'true' only if you want tables or SQLite db files to be dropped/deleted
# when the application shuts down (useful for ephemeral containers or CI test runs).
# Default: false (data is preserved across restarts).
PURGE_DATABASE_ON_SHUTDOWN="false"

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (minimum 32 characters recommended).
AUTH_SECRET_KEY="your-jwt-secret-key-32-chars-minimum"

# Algorithm used for JWT encoding/decoding.
ALGORITHM="HS256"

# ------------------------------------------------------------------------------
# 4. CORS & Frontend Integration
# ------------------------------------------------------------------------------
# Frontend origin allowed to make cross-origin HTTP requests to this backend.
ITBANK_HOMEBANKING_FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. Production Admin Bootstrapper (Optional)
# ------------------------------------------------------------------------------
# Used by 'poetry run python -m src.db.init_db' to provision the initial administrator
# account and default branch office in production environments if no admin exists yet.
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="admin_secure_password_here"
INITIAL_ADMIN_EMAIL="admin@itbank.com"
INITIAL_ADMIN_FULL_NAME="ITBANK Administrator"
